# Copy to .env at the project root. Both the Astro frontend and the FastAPI
# backend read this single file. .env is gitignored.
#
# Naming rule: secrets must NOT be PUBLIC_*. Vite-on-Astro inlines anything
# PUBLIC_* into the browser bundle at build time.

# === Host port mappings (only set these if the defaults collide on your machine) ===
# DB_HOST_PORT=55432
# BACKEND_HOST_PORT=58000
# FRONTEND_HOST_PORT=14321

# === Frontend (PUBLIC_* inlined into the browser bundle) ===
# If you remap BACKEND_HOST_PORT above, update this to match.
PUBLIC_API_BASE_URL=http://localhost:8000

# === Backend: database (compose-internal hostnames in local dev) ===
DATABASE_URL=postgresql+asyncpg://pulse:devpass@db:5432/pulse
ANON_DATABASE_URL=postgresql+asyncpg://pulse_anon:devpass@db:5432/pulse
ADMIN_DATABASE_URL=postgresql+asyncpg://pulse_admin:devpass@db:5432/pulse
# Org-member role (no BYPASSRLS). Admin routes connect as this role so
# RLS narrows every query to the active org's pulse.org_id GUC. The role
# is created by migration 0004; MEMBER_DATABASE_URL falls back to
# DATABASE_URL when unset, but in production it should point at the
# dedicated pulse_member account.
MEMBER_DATABASE_URL=postgresql+asyncpg://pulse_member:devpass@db:5432/pulse

# === Backend: test database (used by pytest, isolated from dev data) ===
TEST_DATABASE_URL=postgresql+asyncpg://pulse:devpass@db:5432/pulse_test
TEST_ANON_DATABASE_URL=postgresql+asyncpg://pulse_anon:devpass@db:5432/pulse_test
TEST_ADMIN_DATABASE_URL=postgresql+asyncpg://pulse_admin:devpass@db:5432/pulse_test
TEST_MEMBER_DATABASE_URL=postgresql+asyncpg://pulse_member:devpass@db:5432/pulse_test

# Used by the postgres compose service only:
POSTGRES_USER=pulse
POSTGRES_PASSWORD=devpass
POSTGRES_DB=pulse

# === Backend: sessions + auth ===
SESSION_SECRET=
SESSION_COOKIE_NAME=pulse_session
SESSION_MAX_AGE_SECONDS=2592000
VERIFY_EMAIL_TOKEN_MAX_AGE_SECONDS=604800
RESET_PASSWORD_TOKEN_MAX_AGE_SECONDS=3600
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_MEMORY_KB=65536

# Frontend URL. Used to construct verification + password-reset links in
# outbound emails. The user clicks a link in their inbox, lands on the
# frontend, which then POSTs the token to the backend.
FRONTEND_BASE_URL=http://localhost:14321

# === Backend: OAuth — Google ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# === Backend: OAuth — Microsoft 365 ===
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
# Whitespace/comma-separated Entra ID tenant ids (`tid` claim) trusted to
# drive the OAuth callback's email-based paths (existing-user-by-email
# match, implicit pending-invite acceptance). Empty = none pinned, so
# those paths are rejected for every Microsoft account — sign-in via an
# explicit invite link still works. See config.py for the full rationale.
MICROSOFT_ALLOWED_TENANT_IDS=

# === Backend: outbound email (Resend) ===
# Transactional mail (org invites, email verification, password reset) is
# sent via Resend's HTTPS API. Empty RESEND_API_KEY keeps send_email in
# log-only mode (the default for dev + tests — no real mail leaves the box).
# EMAIL_FROM must be an address on a Resend-verified domain.
RESEND_API_KEY=
EMAIL_FROM=noreply@pulse.example

# === Backend: CORS / app config ===
CORS_ALLOWED_ORIGIN=http://localhost:4321
UPLOAD_DIR=/var/lib/pulse/uploads
MAX_UPLOAD_BYTES=26214400

# Per-org logo uploads (Settings → Organization → Logo).
MAX_ORG_LOGO_BYTES=500000

# Pulse is invite-only — POST /api/auth/signup returns 404 unless this is
# explicitly enabled. Never set true in production.
SIGNUP_ENABLED=false

# === Backend: scheduled reminders ===
# The daily reminder job nudges recipients who were invited but haven't
# finished. REMINDERS_ENABLED is the deployment-wide master switch — off by
# default so no reminders go out until an operator turns it on.
REMINDERS_ENABLED=false
REMINDER_INACTIVITY_DAYS=7
REMINDER_CADENCE_DAYS=7
REMINDER_MAX=3

# === Backend: reactive cards (LLM-generated follow-up questions) ===
# When a respondent corrects a confirm-edit card, the generation engine
# (pulse_api/reactive.py) may insert 1-2 AI follow-up cards into that
# respondent's deck live. Three gates, all default-off: ANTHROPIC_API_KEY +
# REACTIVE_CARDS_ENABLED (deployment), organizations.reactive_cards_allowed
# (superadmin-managed), engagements.reactive_cards_enabled (org members).
# An empty ANTHROPIC_API_KEY disables the feature regardless of
# REACTIVE_CARDS_ENABLED, unless REACTIVE_FAKE_MODE is on (dev-only —
# short-circuits the API call with a canned proposal so the deck ->
# generation -> poll -> splice loop is clickable locally with no key).
# Never set REACTIVE_FAKE_MODE true in production.
ANTHROPIC_API_KEY=
REACTIVE_CARDS_ENABLED=false
REACTIVE_FAKE_MODE=false
# Any current Claude model id works here — cost estimates are priced for
# claude-fable-5, claude-opus-4-8/-4-7/-4-6, claude-sonnet-5,
# claude-sonnet-4-6, and claude-haiku-4-5 (see MODEL_PRICING in
# api/pulse_api/reactive.py; an id outside that map still generates but
# records no cost estimate). Container env is read at creation — apply
# changes with `docker compose up -d backend`, not `restart`.
REACTIVE_MODEL=claude-opus-4-8
REACTIVE_MAX_OUTPUT_TOKENS=2048
REACTIVE_TIMEOUT_SECONDS=60.0
REACTIVE_MAX_CARDS_PER_GENERATION=2
REACTIVE_MAX_GENERATED_PER_RECIPIENT=10
REACTIVE_MAX_TRIGGER_CHARS=4000
# SDK-level retry count for transient errors (429/5xx/connection). 2 matches
# the anthropic package's own default.
REACTIVE_MAX_RETRIES=2

# === Backend: observability ===
SENTRY_DSN=
ENVIRONMENT=development
LOG_LEVEL=INFO

# === Backend: rate limits (per-IP, per-minute) ===
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_TOKEN_VALIDATION=10/minute
RATE_LIMIT_ACCOUNT_ENUMERATION=5/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_SENSITIVE=10/minute

# === Backend: MCP OAuth 2.1 authorization server ===
# Issuer base URL for endpoints mounted at the domain root (discovery
# metadata, /authorize, /token, /register, /revoke). Empty falls back to
# FRONTEND_BASE_URL.
MCP_ISSUER_URL=

# === Backend: multi-tenant operators ===
# Whitespace- or comma-separated list of emails granted is_superadmin
# at migration / seed time. Superadmins can hit /api/superadmin/* once
# PR 5 lands. Leave empty in dev; populate in prod via Ansible vault.
SUPERADMIN_EMAILS=

# === Off-box backups (deploy + cron ONLY — the app does NOT read these) ===
# Documented here for discoverability. The daily `pulse-backup` cron on the
# VPS pushes the local pg_dump + uploads mirror off-box to Cloudflare R2 (an
# S3-compatible object store) via restic. These are NOT app env vars — they
# are configured in Ansible at deploy/group_vars/all.yml and rendered by the
# cron template into RESTIC_REPOSITORY / RESTIC_PASSWORD / AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY. Off by default; UNTESTED until you provision R2 and
# run `restic init` by hand. Full runbook: deploy/README.md "Off-box backups".
#
# Non-secret — plain values in deploy/group_vars/all.yml:
#   pulse_restic_enabled          # master switch; flip to true only after R2 is provisioned + `restic init` succeeds by hand
#   pulse_restic_r2_bucket        # your Cloudflare R2 bucket name
#   pulse_restic_r2_endpoint      # https://<accountid>.r2.cloudflarestorage.com
#   pulse_restic_retention_days   # daily snapshots to keep (restic forget --keep-daily); default 30
#
# Secret — inline ansible-vault !vault blocks in deploy/group_vars/all.yml
# (currently empty placeholders; set with `ansible-vault encrypt_string`):
#   vault_pulse_restic_password             # restic repo encryption passphrase
#   vault_pulse_restic_r2_access_key_id     # R2 S3 access key id
#   vault_pulse_restic_r2_secret_access_key # R2 S3 secret access key
