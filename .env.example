# Copy to .env.local and fill in real values. .env.local is gitignored.

# ── Supabase project ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Public (Astro inlines anything PUBLIC_* into the browser bundle) ──────
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Service role key for /admin only. Astro code-splits per page, so this is
# only inlined into the admin chunk. Still: anyone who fetches the admin
# bundle can extract it. Acceptable for a single-operator v1, but plan to
# move admin queries behind an edge function before sharing the URL widely.
PUBLIC_SUPABASE_SERVICE_ROLE_KEY=

# SHA-256 of the admin password. Generate with:
#   echo -n "your-password" | shasum -a 256
PUBLIC_ADMIN_PASSWORD_HASH=
