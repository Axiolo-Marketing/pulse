# Copy to .env.local and fill in real values.
# .env.local is gitignored.

# Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=

# Supabase anon (public) key — used by the browser SPA at runtime.
SUPABASE_ANON_KEY=

# Supabase service role key — used ONLY by local scripts (seeding, verification).
# Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Admin password for Tom's /admin view (set later, Milestone 7).
ADMIN_PASSWORD=
