# {{ ansible_managed }}
# Generated by Ansible — edit deploy/group_vars/all.yml or deploy/vault.yml
# and re-run the playbook. Do NOT edit this file by hand on the server.

# ── Database (Unix socket; no password in URL since pg_hba does peer auth
# for the local user, or md5 if the operator chose that). The owner URL
# is used by Alembic only; the running API uses anon + admin URLs.
DATABASE_URL=postgresql+asyncpg://{{ pulse_db_owner }}:{{ vault_pulse_db_owner_password }}@/{{ pulse_db_name }}?host=/var/run/postgresql
ANON_DATABASE_URL=postgresql+asyncpg://{{ pulse_db_anon }}:{{ vault_pulse_db_anon_password }}@/{{ pulse_db_name }}?host=/var/run/postgresql
ADMIN_DATABASE_URL=postgresql+asyncpg://{{ pulse_db_admin }}:{{ vault_pulse_db_admin_password }}@/{{ pulse_db_name }}?host=/var/run/postgresql

# ── Sessions + auth ───────────────────────────────────────────────────────
SESSION_SECRET={{ vault_pulse_session_secret }}
SESSION_COOKIE_NAME=pulse_session
SESSION_MAX_AGE_SECONDS={{ pulse_session_max_age_seconds }}
VERIFY_EMAIL_TOKEN_MAX_AGE_SECONDS=604800
RESET_PASSWORD_TOKEN_MAX_AGE_SECONDS=3600

# ── OAuth (Google) ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID={{ vault_pulse_google_client_id }}
GOOGLE_CLIENT_SECRET={{ vault_pulse_google_client_secret }}
GOOGLE_REDIRECT_URI={{ pulse_google_redirect_uri }}

# ── OAuth (Microsoft 365) ─────────────────────────────────────────────────
MICROSOFT_CLIENT_ID={{ vault_pulse_microsoft_client_id }}
MICROSOFT_CLIENT_SECRET={{ vault_pulse_microsoft_client_secret }}
MICROSOFT_TENANT_ID={{ pulse_microsoft_tenant_id }}
MICROSOFT_REDIRECT_URI={{ pulse_microsoft_redirect_uri }}

# ── SMTP ──────────────────────────────────────────────────────────────────
SMTP_HOST={{ pulse_smtp_host }}
SMTP_PORT={{ pulse_smtp_port }}
SMTP_USER={{ vault_pulse_smtp_user }}
SMTP_PASSWORD={{ vault_pulse_smtp_password }}
SMTP_FROM_EMAIL={{ pulse_smtp_from }}

# ── App config ────────────────────────────────────────────────────────────
# Frontend and API live on the same origin behind nginx, so CORS is a no-op.
# The setting is required by FastAPI's middleware but never matches anything
# in practice.
CORS_ALLOWED_ORIGIN=https://{{ pulse_domain }}
FRONTEND_BASE_URL=https://{{ pulse_domain }}
UPLOAD_DIR={{ pulse_uploads_dir }}
MAX_UPLOAD_BYTES={{ pulse_max_upload_bytes }}
INITIAL_ADMIN_EMAIL={{ pulse_initial_admin_email }}
