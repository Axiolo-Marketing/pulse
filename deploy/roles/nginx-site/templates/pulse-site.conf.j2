# {{ ansible_managed }}
# Pulse vhost only. Other sites under /etc/nginx/sites-available/ are
# untouched.

server {
    listen 80;
    listen [::]:80;
    server_name {{ pulse_domain }};

    # ACME challenge for certbot renewals (uses the system's existing
    # /var/www/letsencrypt webroot if it exists; falls through to the
    # default location otherwise).
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ pulse_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ pulse_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ pulse_domain }}/privkey.pem;

    # The body of POST /api/uploads has to fit through nginx before the
    # backend's MAX_UPLOAD_BYTES check fires.
    client_max_body_size {{ (pulse_max_upload_bytes / (1024 * 1024)) | round(0, 'ceil') | int }}m;

    root {{ pulse_web_root }};
    index index.html;

    # API → uvicorn on 127.0.0.1
    location /api/ {
        proxy_pass http://127.0.0.1:{{ pulse_api_port }};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Streaming downloads from /api/files/* and /api/admin/uploads/*/download
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
    }

    # Static Astro site
    location / {
        try_files $uri $uri/ /index.html;
    }
}
