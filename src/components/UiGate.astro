---
// v1 → v2 gate. Drop into the <head> of a v1 page shell:
//
//   <UiGate v2Path="/v2/unsubscribe" />
//
// Runs as a blocking inline script (before paint, no flash) so it can't import
// a module — the logic is self-contained and mirrors src/lib/ui-version.ts.
//   ?ui=v2  → set sticky cookie + redirect to the v2 page (carrying ?query#hash)
//   ?ui=v1  → sticky opt-out cookie, stay on v1
//   cookie pulse_ui=v2 (and no ?ui) → redirect to the v2 page
//   cookie pulse_ui=v1 (and no ?ui) → stay on v1
//   otherwise → the page's default (`defaultV2`), v1 unless set
interface Props {
  /** Absolute path of the v2 equivalent of this page, e.g. "/v2/unsubscribe". */
  v2Path: string;
  /** Send visitors with no preference to v2. Opt out with `?ui=v1`. */
  defaultV2?: boolean;
}
const { v2Path, defaultV2 = false } = Astro.props;
---

<script is:inline define:vars={{ v2Path, defaultV2 }}>
  (function () {
    try {
      var params = new URLSearchParams(window.location.search);
      var ui = params.get("ui");
      var oneYear = 60 * 60 * 24 * 365;
      var cookies = document.cookie.split("; ");
      if (ui === "v1") {
        // Sticky opt-out, so a v2-by-default page stays on v1 next visit.
        document.cookie =
          "pulse_ui=v1; path=/; max-age=" + oneYear + "; samesite=lax";
        return;
      }
      if (ui === "v2") {
        document.cookie =
          "pulse_ui=v2; path=/; max-age=" + oneYear + "; samesite=lax";
      }
      var wantsV2 =
        ui === "v2" ||
        cookies.indexOf("pulse_ui=v2") !== -1 ||
        (defaultV2 && cookies.indexOf("pulse_ui=v1") === -1);
      if (wantsV2) {
        window.location.replace(
          v2Path + window.location.search + window.location.hash,
        );
      }
    } catch (e) {
      /* never block the page on the gate */
    }
  })();
</script>
