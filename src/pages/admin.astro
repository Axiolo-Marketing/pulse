---
import Favicon from "../components/Favicon.astro";
import "../styles/theme.css";
import AdminApp from "../components/admin/AdminApp.tsx";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex,nofollow" />
    <Favicon />
    <title>Pulse Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Body text uses the system font stack; Epilogue is only the wordmark. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@1,700&display=swap"
    />
  </head>
  <body class="admin-theme">
    <AdminApp client:only="react" />
  </body>
</html>
