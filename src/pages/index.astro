---
import "../styles/pulse.css";
import "../styles/legal.css";
import UiGate from "../components/UiGate.astro";
const base = import.meta.env.BASE_URL ?? "/";
const baseSlash = base.endsWith("/") ? base : `${base}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <UiGate v2Path="/v2/" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2960F6" />
    <link rel="icon" type="image/svg+xml" href={`${baseSlash}favicon.svg`} />
    <title>Pulse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <div class="page">
      <main id="app">
        <div class="loading">Loading...</div>
      </main>
      <div class="app-footer">
        <footer class="made-by-footer">
          <span class="made-by-label">Made by</span>
          <img
            src={`${baseSlash}axiolo-logo.svg`}
            alt="Axiolo"
            class="made-by-logo"
            width="84"
            height="23"
          />
        </footer>
        <footer class="app-legal-footer">
          <a href={`${baseSlash}privacy`}>Privacy Policy</a>
          <span class="sep" aria-hidden="true">·</span>
          <a href={`${baseSlash}terms`}>Terms of Use</a>
        </footer>
      </div>
    </div>

    <script>
      import "../scripts/app.ts";
    </script>
  </body>
</html>
