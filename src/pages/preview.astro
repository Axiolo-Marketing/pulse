---
import "../styles/theme.css";
import PreviewApp from "../components/deck/PreviewApp.tsx";
const base = import.meta.env.BASE_URL ?? "/";
const baseSlash = base.endsWith("/") ? base : `${base}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href={`${baseSlash}favicon.svg`} />
    <title>Deck preview · Pulse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Epilogue = the "pulse" wordmark fallback only; the org's font is
         lazy-loaded by applyBranding. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@1,700&display=swap"
    />
  </head>
  <body>
    <PreviewApp client:only="react" />
  </body>
</html>
