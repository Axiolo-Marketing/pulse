---
import "../../styles/theme.css";
import DeckApp from "../../components/deck/DeckApp.tsx";
const base = import.meta.env.BASE_URL ?? "/";
const baseSlash = base.endsWith("/") ? base : `${base}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2960F6" />
    <link rel="icon" type="image/svg+xml" href={`${baseSlash}favicon.svg`} />
    <title>Pulse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <DeckApp client:only="react" />
    <footer
      class="flex flex-col items-center gap-2 px-5 pb-8 pt-4 text-xs text-muted-foreground"
    >
      <span class="flex items-center gap-1.5">
        Made by
        <img
          src={`${baseSlash}axiolo-logo.svg`}
          alt="Axiolo"
          width="72"
          height="20"
        />
      </span>
      <span class="flex gap-2">
        <a class="hover:text-foreground" href={`${baseSlash}privacy`}
          >Privacy Policy</a
        >
        <span aria-hidden="true">·</span>
        <a class="hover:text-foreground" href={`${baseSlash}terms`}
          >Terms of Use</a
        >
      </span>
    </footer>
  </body>
</html>
