---
import "../../styles/theme.css";
import UnsubscribeApp from "../../components/unsubscribe/UnsubscribeApp.tsx";
const base = import.meta.env.BASE_URL ?? "/";
const baseSlash = base.endsWith("/") ? base : `${base}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2960F6" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href={`${baseSlash}favicon.svg`} />
    <title>Unsubscribe · Pulse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <UnsubscribeApp client:only="react" />
    <footer
      class="mx-auto flex max-w-md justify-center gap-2 px-5 pb-8 text-xs text-muted-foreground"
    >
      <a class="hover:text-foreground" href={`${baseSlash}privacy`}
        >Privacy Policy</a
      >
      <span aria-hidden="true">·</span>
      <a class="hover:text-foreground" href={`${baseSlash}terms`}>Terms of Use</a
      >
    </footer>
  </body>
</html>
